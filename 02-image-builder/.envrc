source_up
export PROXMOX_URL="http://${PROXMOX_HOST_IP}:8006/api2/json"

source_env_if_exists .envrc.private
env_vars_required PROXMOX_HOST_IP PROXMOX_USERNAME PROXMOX_TOKEN
# PROXMOX_USERNAME/PROXMOX_TOKEN se pegan a mano en .envrc.private (gitignoreado).
# Salen de ../01-proxmox-terraform/tokens.yaml, clave "imagebuilder":
#   token_id (antes del "=" en token_value)    -> PROXMOX_USERNAME
#   el secreto (despues del "=" en token_value) -> PROXMOX_TOKEN

export IMAGE_BUILDER_ENV_FILE=$PWD/environment-imagebuilder

# K8S_VERSION no la lee image-builder directamente - existe solo para que
# build-image.sh expanda el "${K8S_VERSION}" que aparece adentro de
# environment-imagebuilder (PACKER_FLAGS) via `envsubst` antes de pasarle
# el archivo a `docker --env-file` (que no interpola nada por su cuenta).
export K8S_VERSION=v1.36
export K8S_RPM_VERSION=1.36.3
export K8S_SERMVER=v1.36
export K8S_DEB_VERSION=1.36.3-1