source_up
# Necesario para trabajar con kind para crear el cluster de bootstrap
export KUBECONFIG=$PWD/.kube/config

# Token capi-management, generado por proxmox-terraform/01-users-and-privileges
# (ver credentials.tf, tokens.yaml). Se lee directo del archivo en vez de
# pegarlo a mano en .envrc.private - misma convencion que PROXMOX_VE_PASSWORD
# en lab/.envrc. token_value viene como "<token_id>!capi=<secreto>" (todo
# junto, como lo genera Proxmox): lo de antes del "=" es PROXMOX_USERNAME,
# lo de despues es PROXMOX_TOKEN_KEY.
_capi_management_tokens_file="../proxmox-terraform/01-users-and-privileges/tokens.yaml"
if [[ -f "$_capi_management_tokens_file" ]]; then
  _capi_management_token_value="$(awk '
    /^management:/ { in_block=1; next }
    in_block && /^[a-zA-Z_-]+:/ { in_block=0 }
    in_block && /token_value:/ {
      sub(/^[ \t]*token_value:[ \t]*/, "")
      gsub(/^["\x27]|["\x27]$/, "")
      print
      exit
    }
  ' "$_capi_management_tokens_file")"
  export PROXMOX_USERNAME="${_capi_management_token_value%%=*}"
  export PROXMOX_TOKEN_KEY="${_capi_management_token_value#*=}"
fi
unset _capi_management_tokens_file _capi_management_token_value

# .envrc.private puede pisar los valores de arriba si hace falta (no
# debería, en el flujo normal).
source_env_if_exists .envrc.private
env_vars_required PROXMOX_USERNAME PROXMOX_TOKEN_KEY
export PROXMOX_TOKEN=$PROXMOX_USERNAME
export PROXMOX_SECRET=$PROXMOX_TOKEN_KEY

## -- Nodo unico -- ##
export PROXMOX_SOURCENODE="$PROXMOX_NODE_NAME"
export ALLOWED_NODES="[${PROXMOX_NODE_NAME}]"

## -- Cluster "management": red y tamano de VMs -- ##
# VM_SSH_KEYS se define en .envrc.private (tu clave publica, la que vas a
# usar para entrar a los nodos reales) - nunca en este archivo, que se
# commitea. cluster.yaml.sample/cluster.yaml/cluster-tooling.yaml la
# referencian como ${VM_SSH_KEYS} y se aplican con envsubst.
env_vars_required VM_SSH_KEYS
export CONTROL_PLANE_ENDPOINT_IP="10.77.100.2" # VIP de kube-vip
export NODE_IP_RANGES="[10.77.100.10-10.77.100.30]"
export GATEWAY="10.77.100.1"
export IP_PREFIX="24"
# Para el `clusterctl init` que corre DESPUES del pivot, contra el propio
# cluster management: ese capmox va a correr dentro de la red nested, y
# no puede llegar a PROXMOX_URL (la IP publica de la instancia EC2) por el
# NAT hairpin de AWS (una instancia no puede conectarse a su propia IP
# publica). Desde adentro de la red nested, Proxmox tambien escucha en el
# gateway del bridge sin ese problema.
export PROXMOX_URL_INTERNAL="https://${GATEWAY}:8006"
export DNS_SERVERS="[1.1.1.1]"
export BRIDGE="vmbr0"

export BOOT_VOLUME_DEVICE="scsi0"
export BOOT_VOLUME_SIZE="100"
export NUM_SOCKETS="2"
export NUM_CORES="2"
export MEMORY_MIB="4096"

export KUBERNETES_VERSION="v1.34.11"

## -- Rate limit del cliente k8s de Cilium hacia el API server -- ##
export QPS="50"
export BURST="100"
