# Plantilla para credentials.yaml. Copiar y completar con tus propios
# valores antes de correr `tofu apply` (ver README.md de este directorio).
# credentials.yaml queda gitignoreado - nunca se commitea con valores
# reales (a diferencia de este .sample, que sí se versiona).
users:
  terraform:
    username: terraform@pve
    password: "CAMBIAR-password-1"
  capi:
    management:
      username: capi-management@pve
      password: "CAMBIAR-password-2"
    tooling:
      username: capi-tooling@pve
      password: "CAMBIAR-password-3"
  pve-exporter:
    username: k8s-pve-exporter@pve
    password: "CAMBIAR-password-4"
  k8s-csi:
    username: k8s-csi@pve
    password: "CAMBIAR-password-5"
  imagebuilder:
    username: imagebuilder@pve
    password: "CAMBIAR-password-6"
