# direnv no trae "layout uv" en su stdlib todavia (es una funcion
# community, propuesta para el core pero no mergeada) - la definimos ac
# mismo en vez de pedir que cada quien la agregue a su
# ~/.config/direnv/direnvrc global, asi el repo funciona solo con
# `direnv allow`. Fuente: https://github.com/direnv/direnv/wiki/Python#uv
layout_uv() {
  watch_file .python-version pyproject.toml uv.lock

  if ! has uv; then
    log_error "uv: command not found. Instalar desde https://docs.astral.sh/uv/"
    return 1
  fi

  if [[ ! -f pyproject.toml ]]; then
    log_error "uv: no se encontro pyproject.toml"
    return 1
  fi

  local venv_path
  venv_path="$(expand_path "${UV_PROJECT_ENVIRONMENT:-.venv}")"
  export UV_PROJECT_ENVIRONMENT="$venv_path"

  uv sync --frozen

  export VIRTUAL_ENV="$venv_path"
  PATH_add "$venv_path/bin"
}

layout uv

export AWS_PROFILE=mw_mikroways.aws-sandbox.us-east-1.AWSAdministratorAccess

################################################################################
# Variables compartidas para 00-lab/, 01-proxmox-terraform/, 02-vm-template/
# y 03-clusterctl/
################################################################################

# Nombre fijo del (unico) nodo Proxmox VE - ver 00-lab/ansible/playbook.yml y
# 02-vm-template/terraform.tfvars.example
export PROXMOX_NODE_NAME="proxmox-lab"

# IP publica del nodo, provisionada por 00-lab/. Se recalcula en cada
# entrada al directorio via `tofu -chdir` (el state vive en 00-lab/, no
# aca): si la instancia se reemplaza y cambia de IP, no hace falta tocar
# nada a mano.
export PROXMOX_HOST_IP="$(tofu -chdir=00-lab output -raw instance_public_ip 2>/dev/null)"
export PROXMOX_URL="https://${PROXMOX_HOST_IP}:8006"

# Credenciales root@pam para los modulos de 01-proxmox-terraform/ y
# 02-vm-template/. El playbook de Ansible de 00-lab/ regenera este
# password en cada corrida (ver 00-lab/ansible/playbook.yml), asi que se
# recalcula en cada entrada al directorio en vez de cachearse a mano en
# un .envrc.private - evita el 401 por password vieja que ya paso una vez
# validando este taller.
export PROXMOX_VE_USERNAME="root@pam"
export PROXMOX_VE_PASSWORD="$(tofu -chdir=00-lab output -raw proxmox_root_password_command 2>/dev/null | sh 2>/dev/null)"
