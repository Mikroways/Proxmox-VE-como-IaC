source_env_if_exists .envrc.layout
source_env_if_exists .envrc.private

layout uv

################################################################################
# Variables compartidas para 00-lab/, 01-proxmox-terraform/, 02-vm-template/
# y 04-clusterctl/
################################################################################

# Nombre fijo del (unico) nodo Proxmox VE - ver 00-lab/ansible/playbook.yml y
# 02-vm-template/terraform.tfvars.example
export PROXMOX_NODE_NAME="proxmox-lab"

# IP publica del nodo, provisionada por 00-lab/. Se recalcula en cada
# entrada al directorio via `tofu -chdir` (el state vive en 00-lab/, no
# aca): si la instancia se reemplaza y cambia de IP, no hace falta tocar
# nada a mano.
#export PROXMOX_HOST_IP="$(tofu -chdir=00-lab output -raw instance_public_ip 2>/dev/null)"
export PROXMOX_HOST_IP="3.90.217.119"
export PROXMOX_VE_ENDPOINT="https://${PROXMOX_HOST_IP}:8006"
export PROXMOX_VE_INSECURE=true

# Credenciales root@pam para los modulos de 01-proxmox-terraform/ y
# 02-vm-template/. El playbook de Ansible de 00-lab/ regenera este
# password en cada corrida (ver 00-lab/ansible/playbook.yml), asi que se
# recalcula en cada entrada al directorio en vez de cachearse a mano en
# un .envrc.private
export PROXMOX_VE_USERNAME="root@pam"
env_vars_required PROXMOX_VE_PASSWORD
