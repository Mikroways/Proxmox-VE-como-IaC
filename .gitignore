# Local .terraform directories
**/.terraform/*
**/.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock file (comentar esta linea si se quiere versionar el lockfile)
# .terraform.lock.hcl

# Claves generadas por el modulo key-pair
*.pem
*.pub

# direnv
.direnv/

# Ansible: roles instalados via requirements.yml (se reinstalan con
# ansible-galaxy) e inventory generado por Terraform via ansible.tf
# (atado a la IP de la instancia de cada apply)
00-lab/ansible/roles/
00-lab/ansible/inventory.yml
*.retry

# uv: venv del proyecto (se recrea con `direnv allow` / `uv sync`).
# pyproject.toml y uv.lock SI se versionan.
.venv/

# Secretos generados localmente por cada asistente - nunca se comitean:
# cada quien genera los suyos contra su propia instancia AWS.
.envrc.private
credentials.yaml
tokens.yaml

# kubeconfigs generados por kind/clusterctl
.kube/
