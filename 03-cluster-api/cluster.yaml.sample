apiVersion: v1
kind: Namespace
metadata:
  name: management
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: proxmox-mw
  namespace: management
  labels:
    cluster.x-k8s.io/cluster-name: proxmox-mw
    baseHelmCharts: enabled
spec:
  clusterNetwork:
    pods:
      cidrBlocks:
      - 10.10.0.0/16
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: ProxmoxCluster
    name: proxmox-mw
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: KubeadmControlPlane
    name: proxmox-mw-control-plane
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha2
kind: ProxmoxCluster
metadata:
  name: proxmox-mw
  namespace: management
  labels:
    cluster.x-k8s.io/cluster-name: proxmox-mw
spec:
  controlPlaneEndpoint:
    host: 10.77.100.2
    port: 6443
  dnsServers:
  - 1.1.1.1
  ipv4Config:
    addresses:
    - 10.77.100.10-10.77.100.30
    gateway: 10.77.100.1
    prefix: 24
  allowedNodes:
  - proxmox-lab
  credentialsRef:
    name: capmox-manager-credentials
    namespace: capmox-system
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: KubeadmControlPlane
metadata:
  name: proxmox-mw-control-plane
  namespace: management
spec:
  replicas: 1
  version: v1.34.10
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: ProxmoxMachineTemplate
        name: proxmox-mw-control-plane
  kubeadmConfigSpec:
    files:
    - path: /etc/capi-install-k8s.sh
      owner: root:root
      permissions: "0700"
      content: |
        #!/bin/bash
        set -euo pipefail

        KUBERNETES_VERSION_SERIES="1.34"
        KUBERNETES_VERSION="1.34.10"

        swapoff -a
        sed -i '/\sswap\s/s/^/#/' /etc/fstab

        apt-get update
        apt-get install -y apt-transport-https ca-certificates curl gpg qemu-guest-agent
        systemctl enable --now qemu-guest-agent

        install -m 0755 -d /etc/apt/keyrings
        curl -fsSL "https://pkgs.k8s.io/core:/stable:/v$${KUBERNETES_VERSION_SERIES}/deb/Release.key" | \
          gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
        chmod 644 /etc/apt/keyrings/kubernetes-apt-keyring.gpg

        echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v$${KUBERNETES_VERSION_SERIES}/deb/ /" \
          > /etc/apt/sources.list.d/kubernetes.list

        apt-get update
        apt-get install -y "kubelet=$${KUBERNETES_VERSION}-*" "kubeadm=$${KUBERNETES_VERSION}-*" "kubectl=$${KUBERNETES_VERSION}-*" containerd
        apt-mark hold kubelet kubeadm kubectl

        mkdir -p /etc/containerd
        containerd config default > /etc/containerd/config.toml
        sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
        systemctl restart containerd
        systemctl enable containerd kubelet

        cat <<EOF > /etc/modules-load.d/k8s.conf
        overlay
        br_netfilter
        EOF
        modprobe overlay
        modprobe br_netfilter

        cat <<EOF > /etc/sysctl.d/k8s.conf
        net.bridge.bridge-nf-call-iptables  = 1
        net.bridge.bridge-nf-call-ip6tables = 1
        net.ipv4.ip_forward                 = 1
        EOF
        sysctl --system
    - content: |
        apiVersion: v1
        kind: Pod
        metadata:
          creationTimestamp: null
          name: kube-vip
          namespace: kube-system
        spec:
          containers:
          - args:
            - manager
            env:
            - name: cp_enable
              value: "true"
            - name: vip_interface
              value: ""
            - name: address
              value: 10.77.100.2
            - name: port
              value: "6443"
            - name: vip_arp
              value: "true"
            - name: vip_leaderelection
              value: "true"
            - name: vip_leaseduration
              value: "15"
            - name: vip_renewdeadline
              value: "10"
            - name: vip_retryperiod
              value: "2"
            image: ghcr.io/kube-vip/kube-vip:v0.7.1
            imagePullPolicy: IfNotPresent
            name: kube-vip
            resources: {}
            securityContext:
              capabilities:
                add:
                - NET_ADMIN
                - NET_RAW
            volumeMounts:
            - mountPath: /etc/kubernetes/admin.conf
              name: kubeconfig
          hostAliases:
          - hostnames:
            - localhost
            - kubernetes
            ip: 127.0.0.1
          hostNetwork: true
          volumes:
          - hostPath:
              path: /etc/kubernetes/admin.conf
              type: FileOrCreate
            name: kubeconfig
        status: {}
      owner: root:root
      path: /etc/kubernetes/manifests/kube-vip.yaml
    - content: |
        #!/bin/bash

        # Copyright 2020 The Kubernetes Authors.
        #
        # Licensed under the Apache License, Version 2.0 (the "License");
        # you may not use this file except in compliance with the License.
        # You may obtain a copy of the License at
        #
        #     http://www.apache.org/licenses/LICENSE-2.0
        #
        # Unless required by applicable law or agreed to in writing, software
        # distributed under the License is distributed on an "AS IS" BASIS,
        # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
        # See the License for the specific language governing permissions and
        # limitations under the License.

        set -e

        # Configure the workaround required for kubeadm init with kube-vip:
        # xref: https://github.com/kube-vip/kube-vip/issues/684

        # Nothing to do for kubernetes < v1.29
        KUBEADM_MINOR="$(kubeadm version -o short | cut -d '.' -f 2)"
        if [[ "$KUBEADM_MINOR" -lt "29" ]]; then
          exit 0
        fi

        IS_KUBEADM_INIT="false"

        # cloud-init kubeadm init
        if [[ -f /run/kubeadm/kubeadm.yaml ]]; then
          IS_KUBEADM_INIT="true"
        fi

        # ignition kubeadm init
        if [[ -f /etc/kubeadm.sh ]] && grep -q -e "kubeadm init" /etc/kubeadm.sh; then
          IS_KUBEADM_INIT="true"
        fi

        if [[ "$IS_KUBEADM_INIT" == "true" ]]; then
          sed -i 's#path: /etc/kubernetes/admin.conf#path: /etc/kubernetes/super-admin.conf#' \
            /etc/kubernetes/manifests/kube-vip.yaml
        fi
      owner: root:root
      path: /etc/kube-vip-prepare.sh
      permissions: "0700"
    preKubeadmCommands:
    - /etc/capi-install-k8s.sh
    - /etc/kube-vip-prepare.sh
    initConfiguration:
      nodeRegistration:
        # Sin workers en este cluster: si kubeadm pone el taint de
        # control-plane, clusterctl init/move (pivot) nunca puede alojar
        # sus propios pods en este nodo (FailedScheduling). Sacarlo despues
        # a mano desincroniza el estado esperado por CAPI (queda marcado
        # NotReady por "NodeKubeadmLabelsAndTaintsSet") - mejor que kubeadm
        # nunca lo ponga.
        taints: []
        kubeletExtraArgs:
        - name: provider-id
          value: "proxmox://'{{ ds.meta_data.instance_id }}'"
    joinConfiguration:
      nodeRegistration:
        taints: []
        kubeletExtraArgs:
        - name: provider-id
          value: "proxmox://'{{ ds.meta_data.instance_id }}'"
    users:
    - name: root
      sshAuthorizedKeys:
      - ${VM_SSH_KEYS}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha2
kind: ProxmoxMachineTemplate
metadata:
  name: proxmox-mw-control-plane
  namespace: management
spec:
  template:
    spec:
      templateSelector:
        matchTags:
        - ubuntu-24.04
      format: raw
      full: true
      storage: local
      pool: capi-management-vm
      numSockets: 2
      numCores: 2
      memoryMiB: 4096
      disks:
        bootVolume:
          disk: scsi0
          sizeGb: 100
      network:
        networkDevices:
        - name: net0
          bridge: vmbr0
          model: virtio
